#--------------------------------------------------------------------
# PRODUCTION ENVIRONMENT CONFIGURATION
#--------------------------------------------------------------------
# This is a production-optimized .env file template
# Copy this to .env and customize for your production server
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'https://your-production-domain.com'
app.forceGlobalSecureRequests = true
app.sessionCookieSecure = true
app.sessionCookieHTTPOnly = true
app.sessionCookieSameSite = 'Strict'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = your-production-db-host
database.default.database = your-production-db-name
database.default.username = your-production-db-user
database.default.password = your-production-db-password
database.default.DBDebug = false
database.default.DBPrefix = 

#--------------------------------------------------------------------
# CONTENT SECURITY POLICY
#--------------------------------------------------------------------
contentsecuritypolicy.reportOnly = false
contentsecuritypolicy.defaultSrc = "'self'"
contentsecuritypolicy.scriptSrc = "'self' 'unsafe-inline'"
contentsecuritypolicy.styleSrc = "'self' 'unsafe-inline'"
contentsecuritypolicy.fontSrc = "'self'"
contentsecuritypolicy.imgSrc = "'self' data: https:"
contentsecuritypolicy.base_uri = "'self'"
contentsecuritypolicy.childSrc = "'self'"
contentsecuritypolicy.connectSrc = "'self'"
contentsecuritypolicy.formAction = "'self'"
contentsecuritypolicy.frameAncestors = "'none'"
contentsecuritypolicy.mediaSrc = "'self'"
contentsecuritypolicy.objectSrc = "'none'"
contentsecuritypolicy.pluginTypes = 
contentsecuritypolicy.reportURI = 
contentsecuritypolicy.sandbox = false
contentsecuritypolicy.upgradeInsecureRequests = true

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
encryption.key = your-32-character-production-key-here
encryption.driver = OpenSSL
encryption.blockSize = 16
encryption.digest = SHA512

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.cookieName = 'lsp_scada_session'
session.expiration = 28800
session.savePath = 
session.matchIP = true
session.timeToUpdate = 300
session.regenerateDestroy = true

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------
logger.threshold = 3

#--------------------------------------------------------------------
# EMAIL CONFIGURATION (Production)
#--------------------------------------------------------------------
email.fromEmail = noreply@your-domain.com
email.fromName = "Your App Name"
email.SMTPHost = your-smtp-host
email.SMTPUser = your-smtp-user
email.SMTPPass = your-smtp-password
email.SMTPPort = 587
email.SMTPCrypto = tls

#--------------------------------------------------------------------
# OAUTH GOOGLE (Production)
#--------------------------------------------------------------------
oauth.google.clientId = your-production-google-client-id
oauth.google.clientSecret = your-production-google-client-secret
oauth.google.redirectUri = https://your-domain.com/oauth/proses

#--------------------------------------------------------------------
# SECURITY HEADERS
#--------------------------------------------------------------------
security.headers.X-Frame-Options = DENY
security.headers.X-Content-Type-Options = nosniff
security.headers.X-Permitted-Cross-Domain-Policies = none
security.headers.Referrer-Policy = no-referrer
security.headers.Permissions-Policy = camera=(), microphone=(), geolocation=()

#--------------------------------------------------------------------
# RATE LIMITING
#--------------------------------------------------------------------
ratelimit.login = 3/900  # 3 attempts per 15 minutes
ratelimit.register = 2/3600  # 2 attempts per hour
ratelimit.api = 100/3600  # 100 requests per hour
